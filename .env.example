# 실제 값은 .env 파일에만 저장하고 절대 커밋하지 말 것

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare Workers AI (FLUX 이미지 생성, 비전 검증, 프롬프트 변환 텍스트 모델 공용)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct
VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# 파이프라인 설정
MAX_AGE_HOURS=24
MIN_LENGTH=50
DEDUP_SIMILARITY_THRESHOLD=85
TITLE_MAX_CHARS=30
