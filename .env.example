# 실제 값은 .env 파일에만 저장하고 절대 커밋하지 말 것

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare Workers AI (카드세트 콘텐츠 생성용 텍스트 모델)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct

# Instagram Graph API (확장: 카드 자동 업로드) - 비워두면 publish_instagram.py가 조용히 건너뜀
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_API_VERSION=v21.0
SUPABASE_STORAGE_BUCKET=cards

# 파이프라인 설정
MAX_AGE_HOURS=24
MIN_LENGTH=50
DEDUP_SIMILARITY_THRESHOLD=70
TITLE_MAX_CHARS=15
MAX_BACKLOG_DAYS=3
SAFE_DAILY_CLOUDFLARE_CALLS=12
