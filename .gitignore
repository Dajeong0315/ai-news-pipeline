.env
channels/*/.env
runtime.local.json
environment/node_modules/
transition/*.json
transition/*.log
__pycache__/
*.pyc
.venv/
venv/
output/*
!output/samples/
logs/
*.log
# 릴스 배경 음원(저작권 무료라도 재배포 조건이 있어 공개 저장소에 올리지 않음)
channels/*/music/*
!channels/*/music/README.md
# 디징 inbox의 날짜별 공고 파일(Aside 루틴이 매일 씀). README만 저장소에 둔다.
channels/*/inbox/*.json
# 디징 스토리 공유 대기 목록(파이프라인과 Aside 루틴이 매일 씀). README만 저장소에 둔다.
channels/*/outbox/*.json
channels/*/outbox/*.tmp

# 수정 전 원본 백업(git에 이미 기록이 있어 저장소에는 안 올림)
backup/

# 스토리 공유 자동화(share_to_story.py)의 페이스북 로그인 브라우저 프로필·쿠키. 기본 위치는 저장소 밖(%LOCALAPPDATA%\cardnews-fb-profile)이지만 혹시 옮겨도 안 올라가게
cardnews-fb-profile/
*.cookies.json

# Aside 운영 기록(성장 실험·노션 허브 작업 메모). 저장소에는 안 올림
growth/
